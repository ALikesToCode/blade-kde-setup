[Icon Theme]
Name=Blade Candy
Comment=Candy application icons with Breeze Dark monochrome status icons for the panel tray
Inherits=breeze-dark,candy-icons,Adwaita,hicolor
Example=folder
Directories=actions/scalable,apps/scalable,devices/scalable,preferences/scalable,mimetypes/scalable,places/16,places/48

[actions/scalable]
Size=16
Context=Actions
MinSize=8
MaxSize=64
Type=Scalable

[apps/scalable]
Size=96
Context=Applications
MinSize=8
MaxSize=512
Type=Scalable

[devices/scalable]
Size=96
Context=Applications
MinSize=8
MaxSize=512
Type=Scalable

[preferences/scalable]
Size=96
Context=Applications
MinSize=8
MaxSize=512
Type=Scalable

[mimetypes/scalable]
Size=96
Context=MimeTypes
Type=Scalable
MinSize=8
MaxSize=256

[places/16]
Size=16
Context=Places
MinSize=8
MaxSize=32
Type=Scalable

[places/48]
Size=48
Context=Places
MinSize=8
MaxSize=512
Type=Scalable
