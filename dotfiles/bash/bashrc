
# ~/.bashrc — interactive Bash configuration

# User-installed commands, including Codex, without duplicating PATH entries
# when this file is sourced more than once.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# Stop here when Bash is not interactive.
case $- in
    *i*) ;;
      *) return ;;
esac

# History: append across terminals and avoid duplicate/noisy entries.
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend
shopt -s checkwinsize

# Update the history file after each command so parallel terminals stay useful.
__bash_history_sync() {
    history -a
    history -n
}
PROMPT_COMMAND="__bash_history_sync${PROMPT_COMMAND:+;$PROMPT_COMMAND}"

# Readline and programmable completion.
bind 'set completion-ignore-case on'
bind 'set show-all-if-ambiguous on'
bind 'set colored-stats on'

if [[ -r /usr/share/bash-completion/bash_completion ]]; then
    source /usr/share/bash-completion/bash_completion
elif [[ -r /etc/bash_completion ]]; then
    source /etc/bash_completion
fi

# Sensible defaults for interactive tools.
export LESS='-R'
if [[ -t 0 ]]; then
    export GPG_TTY="$(tty)"
fi

if [[ -z ${EDITOR:-} ]]; then
    if command -v nvim >/dev/null 2>&1; then
        export EDITOR=nvim
    elif command -v vim >/dev/null 2>&1; then
        export EDITOR=vim
    else
        export EDITOR=nano
    fi
fi
export VISUAL="$EDITOR"

# Artix Dark Rounded prompt. Requires a Nerd Font for the logo and rounded caps.
if [[ ${TERM:-dumb} != dumb ]]; then
    PS1='\[\e[38;2;13;17;23m\]\[\e[48;2;13;17;23m\]\[\e[38;2;80;250;123m\]   \u\[\e[38;2;56;189;248m\]@\h \[\e[38;2;121;192;255m\]\w \[\e[0m\]\[\e[38;2;13;17;23m\]\[\e[0m\]\n\[\e[38;2;80;250;123m\]❯\[\e[38;2;56;189;248m\]❯\[\e[0m\] '
else
    PS1='\u@\h \w\n$ '
fi

# Colored output and convenient directory listings.
alias grep='grep --color=auto'
alias diff='diff --color=auto'

if command -v eza >/dev/null 2>&1; then
    alias ls='eza --group-directories-first'
    alias ll='eza -lah --group-directories-first --git'
    alias la='eza -a --group-directories-first'
    alias tree='eza --tree --group-directories-first'
else
    alias ls='ls --color=auto'
    alias ll='ls -lah --color=auto'
    alias la='ls -A --color=auto'
fi

if command -v bat >/dev/null 2>&1; then
    alias bcat='bat --paging=never'
fi

alias ..='cd ..'
alias ...='cd ../..'
alias cls='clear'

# Load per-project environments when direnv is installed and authorized.
if command -v direnv >/dev/null 2>&1; then
    eval "$(direnv hook bash)"
fi
