[Unit]
Description=Refresh aria2 public tracker list
Documentation=https://github.com/ngosang/trackerslist https://github.com/mrgusux/automatic-trackers
After=network-online.target aria2.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/aria2-update-trackers
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
