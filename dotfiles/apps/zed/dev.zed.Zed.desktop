[Desktop Entry]
Version=1.0
Type=Application
Name=Zed
GenericName=Text Editor
Comment=High-performance Vulkan editor on native Wayland
TryExec=__HOME__/.local/bin/zeditor
StartupNotify=true
Exec=__HOME__/.local/bin/zeditor %U
Icon=zed
Categories=Development;IDE;
Keywords=zed;
MimeType=text/plain;application/x-zerosize;x-scheme-handler/zed;
Actions=NewWorkspace;

[Desktop Action NewWorkspace]
Exec=__HOME__/.local/bin/zeditor --new %U
Name=Open a new workspace
