#!/usr/bin/env bash
# CloakBrowser-backed Playwright MCP for ordinary Codex sessions.
# The MCP process owns a verified, loopback-only browser for its own lifetime.
set -Eeuo pipefail
umask 077

die() {
  printf 'playwright-mcp-cloak: ERROR: %s\n' "$*" >&2
  exit 1
}

set_browser_mode() {
  local candidate=$1
  [[ -z "$browser_mode" ]] || die "browser mode was specified more than once"
  case "$candidate" in
    headless|headed) browser_mode=$candidate ;;
    *) die "browser mode must be headless or headed" ;;
  esac
}

browser_mode=''
describe_mode=0
end_options=0
mcp_args=()
args=("$@")
for ((i=0; i<${#args[@]}; i++)); do
  arg=${args[i]}
  if (( end_options )); then
    mcp_args+=("$arg")
    continue
  fi
  case "$arg" in
    --)
      end_options=1
      mcp_args+=("$arg")
      ;;
    --browser-mode)
      (( i + 1 < ${#args[@]} )) || die "--browser-mode requires headless or headed"
      set_browser_mode "${args[++i]}"
      ;;
    --browser-mode=*) set_browser_mode "${arg#*=}" ;;
    --describe-browser-mode) describe_mode=1 ;;
    *) mcp_args+=("$arg") ;;
  esac
done

[[ -n "$browser_mode" ]] || die "explicit --browser-mode=headless or --browser-mode=headed is required"
if (( describe_mode )); then
  case "$browser_mode" in
    headless) printf 'browser-mode=headless display=disabled input=cdp-only\n' ;;
    headed) printf 'browser-mode=headed display=visible-nested-kde input=cdp-only\n' ;;
  esac
  exit 0
fi

host_home=$(realpath -e -- "$HOME" 2>/dev/null) || die "cannot resolve HOME"
config_file="$host_home/.config/codex-safe/config"
[[ -r "$config_file" ]] || die "verified CloakBrowser configuration is missing"
# shellcheck source=/dev/null
source "$config_file"
[[ -r "${CODEX_SAFE_NESTED_DISPLAY_LIB-}" ]] || die "nested-display library is missing"
# shellcheck source=/dev/null
source "$CODEX_SAFE_NESTED_DISPLAY_LIB"

# codex-safe supplies a stricter, in-jail browser path of its own.
if [[ "${CODEX_SAFE_ACTIVE-}" == 1 ]]; then
  safe_mode=headless
  case "${CODEX_SAFE_HEADED-false}" in
    true|TRUE|1|yes|YES) safe_mode=headed ;;
  esac
  [[ "$browser_mode" == "$safe_mode" ]] || \
    die "requested $browser_mode mode does not match the active codex-safe $safe_mode browser"
  exec env -u DISPLAY -u WAYLAND_DISPLAY -u XAUTHORITY \
    "$PLAYWRIGHT_MCP_SAFE" "${mcp_args[@]}"
fi

[[ -x "$CLOAKSERVE_BIN" ]] || die "cloakserve is missing"
[[ -x "$CLOAKBROWSER_BINARY_PATH" ]] || die "patched CloakBrowser Chromium is missing"
[[ -x "$PLAYWRIGHT_MCP_REAL" ]] || die "official Playwright MCP is missing"

cloak_binary_real=$(realpath -e -- "$CLOAKBROWSER_BINARY_PATH") || die "cannot resolve patched Chromium"
[[ "$cloak_binary_real" == "$host_home/.cloakbrowser/"* ]] || die "patched Chromium escaped the verified cache"
browser_sha=$(sha256sum "$cloak_binary_real" | awk '{print $1}')
[[ "$browser_sha" == "$CLOAKBROWSER_BINARY_SHA256" ]] || die "patched Chromium checksum mismatch"

workspace=$(realpath -e -- /proc/self/cwd 2>/dev/null) || die "cannot resolve Codex working directory"
[[ -d "$workspace" && "$workspace" == /* ]] || die "Codex working directory is invalid"
case "$workspace" in
  /|"$host_home") die "refusing an unsafe artifact root: $workspace" ;;
esac

artifact_dir="$workspace/.playwright-cli"
install -d -m 700 "$artifact_dir"

runtime_root="/tmp/playwright-mcp-cloak-$(id -u)"
[[ ! -L "$runtime_root" ]] || die "private browser runtime root must not be a symlink"
install -d -m 700 "$runtime_root"
[[ $(stat -Lc '%u' -- "$runtime_root") == "$(id -u)" ]] || die "private browser runtime root has the wrong owner"
runtime_mode=$(stat -Lc '%a' -- "$runtime_root")
(( (8#$runtime_mode & 8#077) == 0 )) || die "private browser runtime root is accessible by group or world"
runtime_dir=$(mktemp -d "$runtime_root/session.XXXXXXXX")

browser_home="$runtime_dir/browser-home"
browser_state="$runtime_dir/browser-state"
browser_runtime="$runtime_dir/browser-runtime"
browser_cache="$runtime_dir/browser-cache"
browser_config="$runtime_dir/browser-config"
install -d -m 700 "$browser_home" "$browser_state" "$browser_runtime" "$browser_cache" "$browser_config"

cloak_pid=''
mcp_pid=''
cleanup_done=0
# Invoked indirectly by the EXIT trap.
# shellcheck disable=SC2329
cleanup() {
  local rc=$?
  (( cleanup_done == 0 )) || return "$rc"
  cleanup_done=1
  set +e
  if [[ -n "$mcp_pid" ]] && kill -0 "$mcp_pid" 2>/dev/null; then
    kill -TERM "$mcp_pid" 2>/dev/null || true
  fi
  if [[ -n "$cloak_pid" ]] && kill -0 "$cloak_pid" 2>/dev/null; then
    kill -TERM -- "-$cloak_pid" 2>/dev/null || kill -TERM "$cloak_pid" 2>/dev/null || true
    for _ in {1..30}; do
      kill -0 "$cloak_pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$cloak_pid" 2>/dev/null; then
      kill -KILL -- "-$cloak_pid" 2>/dev/null || kill -KILL "$cloak_pid" 2>/dev/null || true
    fi
  fi
  codex_safe_stop_nested_display
  case "$runtime_dir" in
    "$runtime_root"/session.*) rm -rf -- "$runtime_dir" ;;
  esac
  return "$rc"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

port=$(python -S -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')
[[ "$port" =~ ^[0-9]+$ && "$port" -ge 1024 && "$port" -le 65535 ]] || die "failed to allocate a loopback port"
fingerprint_seed=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
[[ "$fingerprint_seed" =~ ^[0-9a-f]{48}$ ]] || die "failed to generate a fingerprint seed"

locale_value=${CODEX_CLOAK_LOCALE:-en-US}
timezone_value=${CODEX_CLOAK_TIMEZONE:-Asia/Kolkata}
[[ "$locale_value" =~ ^[A-Za-z0-9._-]{2,35}$ ]] || die "invalid CODEX_CLOAK_LOCALE"
[[ "$timezone_value" =~ ^[A-Za-z0-9._+-]+(/[A-Za-z0-9._+-]+)*$ ]] || die "invalid CODEX_CLOAK_TIMEZONE"

cloak_args=(
  "--port=$port"
  "--data-dir=$browser_state"
  "--idle-timeout=0"
  "--fingerprint=$fingerprint_seed"
  "--fingerprint-locale=$locale_value"
  "--fingerprint-timezone=$timezone_value"
  "--password-store=basic"
)
case "$browser_mode" in
  headless)
    cloak_args+=("--headless=new")
    ;;
  headed)
    cloak_args+=("--headless=false" "--ozone-platform=x11")
    ;;
esac

export CLOAKBROWSER_AUTO_UPDATE=false
export CLOAKBROWSER_BINARY_PATH=$cloak_binary_real
export CLOAKBROWSER_CACHE_DIR="$host_home/.cloakbrowser"
export CLOAKSERVE_IDLE_TIMEOUT=0
export CODEX_CLOAK_BROWSER_MODE=$browser_mode

if [[ "$browser_mode" == headless ]]; then
  CODEX_SAFE_HOST_HOME="$host_home" \
  CLOAKSERVE_SOURCE_SHA256="$CLOAKSERVE_SOURCE_SHA256" \
  HOME="$browser_home" \
  XDG_RUNTIME_DIR="$browser_runtime" \
  XDG_CACHE_HOME="$browser_cache" \
  XDG_CONFIG_HOME="$browser_config" \
  DBUS_SESSION_BUS_ADDRESS=disabled: \
  DBUS_SYSTEM_BUS_ADDRESS=disabled: \
    setsid env -u DISPLAY -u WAYLAND_DISPLAY -u XAUTHORITY \
      "$CLOAKSERVE_BIN" "${cloak_args[@]}" >"$runtime_dir/cloakserve.log" 2>&1 &
else
  codex_safe_start_nested_display "$runtime_root" "$runtime_dir/nested-display" || \
    die "cannot start the visible cursor-isolated display"
  CODEX_SAFE_HOST_HOME="$host_home" \
  CLOAKSERVE_SOURCE_SHA256="$CLOAKSERVE_SOURCE_SHA256" \
  HOME="$browser_home" \
  XDG_RUNTIME_DIR="$browser_runtime" \
  XDG_CACHE_HOME="$browser_cache" \
  XDG_CONFIG_HOME="$browser_config" \
  DISPLAY="$CODEX_SAFE_NESTED_DISPLAY" \
  XAUTHORITY="$CODEX_SAFE_NESTED_XAUTHORITY" \
  DBUS_SESSION_BUS_ADDRESS=disabled: \
  DBUS_SYSTEM_BUS_ADDRESS=disabled: \
    setsid "$CLOAKSERVE_BIN" "${cloak_args[@]}" >"$runtime_dir/cloakserve.log" 2>&1 &
fi
cloak_pid=$!

endpoint="http://127.0.0.1:$port?fingerprint=$fingerprint_seed&timezone=$timezone_value&locale=$locale_value"
health_url="http://127.0.0.1:$port/json/version?fingerprint=$fingerprint_seed&timezone=$timezone_value&locale=$locale_value"
deadline=$((SECONDS + ${CODEX_SAFE_CDP_TIMEOUT_SECONDS:-30}))
health_ok=0
while (( SECONDS < deadline )); do
  kill -0 "$cloak_pid" 2>/dev/null || die "cloakserve exited during startup"
  if curl --fail --silent --show-error --max-time 2 "$health_url" >"$runtime_dir/cdp-version.json" 2>/dev/null; then
    health_ok=1
    break
  fi
  sleep 0.2
done
(( health_ok == 1 )) || die "CloakBrowser CDP health check timed out"

listen_addresses=$(ss -H -ltn "sport = :$port" | awk '{print $4}')
[[ -n "$listen_addresses" ]] || die "cloakserve is not listening"
while IFS= read -r address; do
  [[ "$address" == "127.0.0.1:$port" ]] || die "cloakserve is not loopback-only: $address"
done <<<"$listen_addresses"

curl --fail --silent --show-error --max-time 2 "http://127.0.0.1:$port/" >"$runtime_dir/cloak-status.json" || \
  die "cannot read cloakserve process status"
browser_pid=$(jq -er --arg seed "$fingerprint_seed" '.processes[$seed].pid | select(type=="number")' "$runtime_dir/cloak-status.json") || \
  die "generated fingerprint process is absent"
browser_exe=$(readlink -f -- "/proc/$browser_pid/exe" 2>/dev/null || true)
[[ "$browser_exe" == "$cloak_binary_real" ]] || die "CDP process is not verified CloakBrowser Chromium"

server_headless_flag=''
while IFS= read -r -d '' token; do
  case "$token" in --headless|--headless=*) server_headless_flag=$token ;; esac
done <"/proc/$cloak_pid/cmdline"
browser_parent_pid=$(awk '$1=="PPid:" {print $2}' "/proc/$browser_pid/status")
[[ "$browser_parent_pid" =~ ^[0-9]+$ ]] || die "cannot resolve the CloakBrowser parent process"
server_display=''
while IFS= read -r -d '' entry; do
  case "$entry" in DISPLAY=*) server_display=${entry#DISPLAY=} ;; esac
done <"/proc/$browser_parent_pid/environ"
headless_flag=''
while IFS= read -r -d '' token; do
  case "$token" in --headless|--headless=*) headless_flag=$token ;; esac
done <"/proc/$browser_pid/cmdline"
if [[ "$browser_mode" == headless ]]; then
  [[ "$server_headless_flag" == "--headless=new" ]] || die "cloakserve did not receive explicit headless mode"
  [[ -z "$server_display" ]] || die "headless cloakserve unexpectedly has a desktop display"
else
  [[ "$server_headless_flag" == "--headless=false" ]] || die "cloakserve did not receive explicit headed mode"
  [[ "$server_display" == "$CODEX_SAFE_NESTED_DISPLAY" ]] || \
    die "headed cloakserve is not using its visible nested display"
  [[ "$server_display" != "$CODEX_SAFE_HOST_DISPLAY" ]] || \
    die "headed cloakserve connected directly to the host KDE display"
  [[ -z "$headless_flag" ]] || die "headed Chromium unexpectedly retained a headless launch flag"
fi

playwright_mcp_config="$runtime_dir/playwright-mcp.json"
jq -n \
  --arg endpoint "$endpoint" \
  --arg output "$artifact_dir" \
  --arg locale "$locale_value" \
  --arg timezone "$timezone_value" \
  '{browser:{browserName:"chromium",isolated:true,cdpEndpoint:$endpoint,cdpTimeout:20000,contextOptions:{locale:$locale,timezoneId:$timezone,acceptDownloads:true}},outputDir:$output,saveSession:true,allowUnrestrictedFileAccess:false}' \
  >"$playwright_mcp_config"
chmod 600 "$playwright_mcp_config"

export CLOAK_CDP_ENDPOINT=$endpoint
export PLAYWRIGHT_MCP_CDP_ENDPOINT=$endpoint
export PLAYWRIGHT_MCP_CONFIG=$playwright_mcp_config
export PLAYWRIGHT_MCP_OUTPUT_DIR=$artifact_dir
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
export PLAYWRIGHT_BROWSERS_PATH="$runtime_dir/no-stock-browsers"

env -u DISPLAY -u WAYLAND_DISPLAY -u XAUTHORITY \
  "$PLAYWRIGHT_MCP_REAL" --config "$playwright_mcp_config" "${mcp_args[@]}" 0<&0 &
mcp_pid=$!
set +e
wait "$mcp_pid"
rc=$?
set -e
mcp_pid=''
exit "$rc"
