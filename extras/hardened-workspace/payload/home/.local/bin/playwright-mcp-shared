#!/usr/bin/env bash
# Own the single shared ordinary-Codex Playwright MCP service.
set -Eeuo pipefail
umask 077

die() {
  printf 'playwright-mcp-shared: ERROR: %s\n' "$*" >&2
  exit 1
}

(( $# == 0 )) || die "this service does not accept command-line arguments"

host_home=$(realpath -e -- "$HOME" 2>/dev/null) || die "cannot resolve HOME"
mode_file="$host_home/.config/codex-safe/playwright-mcp-service-mode"
[[ -f "$mode_file" && ! -L "$mode_file" ]] || die "browser mode file is missing or is a symlink"
[[ $(stat -Lc '%u' -- "$mode_file") == "$(id -u)" ]] || die "browser mode file has the wrong owner"
mode_bits=$(stat -Lc '%a' -- "$mode_file")
(( (8#$mode_bits & 8#077) == 0 )) || die "browser mode file is accessible by group or world"

IFS= read -r browser_mode <"$mode_file" || die "cannot read browser mode file"
case "$browser_mode" in
  headless|headed) ;;
  *) die "browser mode file must contain headless or headed" ;;
esac
[[ $(wc -l <"$mode_file") == 1 ]] || die "browser mode file contains extra lines"

launcher="$host_home/.local/bin/playwright-mcp-cloak"
[[ -x "$launcher" && ! -L "$launcher" ]] || die "CloakBrowser MCP launcher is missing or is a symlink"

exec "$launcher" \
  "--browser-mode=$browser_mode" \
  --host 127.0.0.1 \
  --port 49631 \
  --shared-browser-context
