#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

die() {
  printf 'playwright-mcp-safe: ERROR: %s\n' "$*" >&2
  exit 1
}

[[ "${CODEX_SAFE_ACTIVE-}" == 1 ]] || die "must run inside codex-safe"
[[ -n "${CLOAK_CDP_ENDPOINT-}" && -r "${PLAYWRIGHT_MCP_CONFIG-}" ]] || die "verified CDP configuration is missing"
config_file="$HOME/.config/codex-safe/config"
[[ -r "$config_file" ]] || die "codex-safe config is missing"
# shellcheck source=/dev/null
source "$config_file"
[[ -x "$PLAYWRIGHT_MCP_REAL" ]] || die "official @playwright/mcp executable is missing"
cd "$PLAYWRIGHT_MCP_OUTPUT_DIR"
exec env -u DISPLAY -u WAYLAND_DISPLAY -u XAUTHORITY \
  "$PLAYWRIGHT_MCP_REAL" --config "$PLAYWRIGHT_MCP_CONFIG" "$@"
