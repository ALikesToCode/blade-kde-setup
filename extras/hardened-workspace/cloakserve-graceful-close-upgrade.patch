+    async def _request_browser_close(self, proc: ChromeProcess) -> None:
+        """Ask Chromium to commit profile state and exit through CDP."""
+        try:
+            timeout = aiohttp.ClientTimeout(total=2)
+            async with aiohttp.ClientSession(timeout=timeout) as session:
+                async with session.get(
+                    f"http://127.0.0.1:{proc.cdp_port}/json/version"
+                ) as response:
+                    response.raise_for_status()
+                    version = await response.json()
+            endpoint = version.get("webSocketDebuggerUrl")
+            if not endpoint:
+                raise RuntimeError("CDP version response lacks a browser endpoint")
+            async with websockets.connect(
+                endpoint,
+                max_size=None,
+                ping_interval=None,
+                ping_timeout=None,
+            ) as cdp_ws:
+                await cdp_ws.send(json.dumps({"id": 1, "method": "Browser.close"}))
+        except Exception as exc:
+            logger.warning(
+                "Graceful Browser.close failed for pid=%d: %s",
+                proc.process.pid,
+                exc,
+            )
+
