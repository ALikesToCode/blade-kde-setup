index 0000000..19e37fd
--- /dev/null
+++ b/package/contents/ui/BladeMaterial.qml
@@ -0,0 +1,19 @@
+import QtQuick
+import org.kde.kirigami as Kirigami
+
+QtObject {
+    readonly property color background: "#080d14"
+    readonly property color surface: "#0d1520"
+    readonly property color elevated: "#111c29"
+    readonly property color outline: "#263b55"
+    readonly property color blue: "#8ab4f8"
+    readonly property color green: "#81c995"
+    readonly property color cyan: "#54d1ff"
+    readonly property color text: "#f0f6fc"
+    readonly property color muted: "#9aa7b5"
+
+    readonly property int popupRadius: Math.round(Kirigami.Units.gridUnit * 1.05)
+    readonly property int cardRadius: Math.round(Kirigami.Units.gridUnit * 0.75)
+    readonly property int contentPadding: Kirigami.Units.largeSpacing
+    readonly property int accentHeight: Math.max(2, Math.round(Kirigami.Units.devicePixelRatio * 2))
+}
