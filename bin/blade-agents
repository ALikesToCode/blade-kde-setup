#!/usr/bin/env python3
"""Locate the installed or checkout-local Blade Agents modules."""

import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True
checkout = Path(__file__).resolve().parent.parent / "lib"
installed = Path(os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))) / "blade-kde/lib"
sys.path.insert(0, str(checkout if (checkout / "blade_agents").is_dir() else installed))

from blade_agents.cli import run

run()
