#!/usr/bin/env python3
"""Serve the pinned AriaNg UI and its local aria2 connection bootstrap."""

from __future__ import annotations

import argparse
import base64
import os
import re
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlencode, urlsplit

VERSION = "1.3.14"
RPC_PORT = 14141
UI_PORT = 14142
UI_HOST = "127.0.0.1"
SECRET_PATTERN = re.compile(r"^[0-9a-fA-F]{64}$")


def installation_paths() -> tuple[Path, Path]:
    home = Path.home()
    ui_root = home / ".local" / "share" / "ariang" / "releases" / VERSION
    secret_file = home / ".config" / "aria2" / "rpc-secret"
    return ui_root, secret_file


def validate_installation() -> tuple[Path, Path]:
    ui_root, secret_file = installation_paths()
    if ui_root.is_symlink() or not ui_root.is_dir():
        raise RuntimeError(f"AriaNg {VERSION} is not installed at {ui_root}")
    for name in ("index.html", "LICENSE", "VERSION"):
        path = ui_root / name
        if path.is_symlink() or not path.is_file():
            raise RuntimeError(f"AriaNg release file is missing or unsafe: {path}")
    if (ui_root / "VERSION").read_text(encoding="ascii").strip() != VERSION:
        raise RuntimeError("AriaNg release version does not match the server")

    if secret_file.is_symlink() or not secret_file.is_file():
        raise RuntimeError(f"aria2 RPC secret is missing or unsafe: {secret_file}")
    metadata = secret_file.stat()
    if metadata.st_uid != os.getuid() or metadata.st_mode & 0o077:
        raise RuntimeError("aria2 RPC secret permissions are unsafe")
    load_secret(secret_file)
    return ui_root, secret_file


def load_secret(secret_file: Path) -> str:
    secret = secret_file.read_text(encoding="ascii").strip()
    if not SECRET_PATTERN.fullmatch(secret):
        raise RuntimeError("aria2 RPC secret must contain 64 hexadecimal characters")
    return secret


def configuration_target(secret: str) -> str:
    encoded_secret = base64.urlsafe_b64encode(secret.encode("ascii")).decode("ascii")
    query = urlencode(
        {
            "protocol": "http",
            "host": "127.0.0.1",
            "port": str(RPC_PORT),
            "interface": "jsonrpc",
            "secret": encoded_secret.rstrip("="),
        }
    )
    return f"/#!/settings/rpc/set?{query}"


class AriaNgRequestHandler(SimpleHTTPRequestHandler):
    def __init__(
        self,
        *args: object,
        secret_file: Path,
        **kwargs: object,
    ) -> None:
        self.secret_file = secret_file
        super().__init__(*args, **kwargs)

    def do_GET(self) -> None:
        path = urlsplit(self.path).path
        if path == "/healthz":
            body = f"AriaNg {VERSION}\n".encode("ascii")
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=us-ascii")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        if path == "/configure":
            secret = load_secret(self.secret_file)
            self.send_response(302)
            self.send_header("Location", configuration_target(secret))
            self.send_header("Cache-Control", "no-store")
            self.send_header("Pragma", "no-cache")
            self.end_headers()
            return
        super().do_GET()

    def list_directory(self, _path: str) -> None:
        self.send_error(404)
        return None

    def end_headers(self) -> None:
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("X-Frame-Options", "DENY")
        super().end_headers()

    def log_message(self, _format: str, *_args: object) -> None:
        return


class LocalThreadingHTTPServer(ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True


def serve(ui_root: Path, secret_file: Path) -> None:
    handler = partial(
        AriaNgRequestHandler,
        directory=str(ui_root),
        secret_file=secret_file,
    )
    with LocalThreadingHTTPServer((UI_HOST, UI_PORT), handler) as server:
        server.serve_forever()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--check",
        action="store_true",
        help="validate the installed UI and aria2 RPC secret without listening",
    )
    arguments = parser.parse_args()
    try:
        ui_root, secret_file = validate_installation()
        if arguments.check:
            print(f"AriaNg {VERSION} installation is valid.")
            return 0
        serve(ui_root, secret_file)
    except (OSError, RuntimeError, UnicodeError) as error:
        parser.exit(1, f"ariang-server: ERROR: {error}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
