#!/usr/bin/env bash

set -Eeuo pipefail

default_sources=$'https://raw.githubusercontent.com/ngosang/trackerslist/master/trackers_all_ip.txt\nhttps://raw.githubusercontent.com/mrgusux/automatic-trackers/main/all_trackers.txt'
tracker_sources="${ARIA2_TRACKER_SOURCES:-$default_sources}"
tracker_limit="${ARIA2_TRACKER_LIMIT:-200}"
minimum_trackers="${ARIA2_TRACKER_MINIMUM:-20}"
config_root="${XDG_CONFIG_HOME:-$HOME/.config}/aria2"
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/aria2"
tracker_config="$state_root/trackers.conf"
runtime_config="$state_root/daemon.conf"
secret_file="$config_root/rpc-secret"
curl_bin="${CURL_BIN:-/usr/bin/curl}"
jq_bin="${JQ_BIN:-/usr/bin/jq}"
work_root=

cleanup() {
    [[ -z $work_root ]] || rm -rf -- "$work_root"
}
trap cleanup EXIT

die() {
    printf 'aria2 trackers: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'aria2 trackers: %s\n' "$*" >&2
}

is_public_tracker() {
    local url=$1 authority host lowered second_octet

    [[ $url != *,* && ! $url =~ [[:space:]] && ${#url} -le 2048 ]] || return 1
    authority=${url#*://}
    authority=${authority%%/*}
    [[ -n $authority && $authority != *@* ]] || return 1

    if [[ $authority == \[* ]]; then
        host=${authority#\[}
        host=${host%%\]*}
    else
        host=${authority%%:*}
    fi
    lowered=${host,,}
    case $lowered in
        ''|localhost|localhost.*|*.local|0.*|10.*|127.*|169.254.*|192.168.*)
            return 1
            ;;
    esac
    if [[ $lowered == *:* ]]; then
        case $lowered in
            ::|::1|fc*|fd*|fe8*|fe9*|fea*|feb*) return 1 ;;
        esac
    fi
    if [[ $lowered =~ ^172\.([0-9]{1,3})\. ]]; then
        second_octet=${BASH_REMATCH[1]}
        ((second_octet < 16 || second_octet > 31)) || return 1
    fi
    if [[ $lowered =~ ^100\.([0-9]{1,3})\. ]]; then
        second_octet=${BASH_REMATCH[1]}
        ((second_octet < 64 || second_octet > 127)) || return 1
    fi
}

normalize_source() {
    local input=$1 output=$2 line count=0 invalid=0

    : > "$output"
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        [[ -n $line ]] || continue
        case $line in
            udp://*|http://*|https://*)
                if is_public_tracker "$line"; then
                    printf '%s\n' "$line" >> "$output"
                    ((count += 1))
                fi
                ;;
            ws://*|wss://*)
                ;;
            *)
                ((invalid += 1))
                ;;
        esac
    done < "$input"

    ((invalid == 0 && count > 0))
}

[[ $tracker_limit =~ ^[0-9]+$ && $minimum_trackers =~ ^[0-9]+$ ]] \
    || die 'tracker limits must be positive integers'
((tracker_limit >= minimum_trackers && tracker_limit <= 500)) \
    || die 'tracker limit must be between the minimum and 500'
[[ -x $curl_bin ]] || die "curl executable not found: $curl_bin"
[[ -x $jq_bin ]] || die "jq executable not found: $jq_bin"

umask 0077
install -d -m 0700 -- "$state_root"
work_root=$(mktemp -d "$state_root/.tracker-update.XXXXXX")
merged="$work_root/merged.txt"
selected="$work_root/selected.txt"
candidate="$work_root/trackers.conf"
: > "$merged"

source_index=0
successful_sources=0
while IFS= read -r source; do
    [[ -n $source ]] || continue
    ((source_index += 1))
    downloaded="$work_root/source-$source_index.txt"
    normalized="$work_root/source-$source_index.normalized"
    if ! "$curl_bin" --fail --location --silent --show-error --retry 3 \
        --connect-timeout 10 --max-time 45 --max-filesize 262144 \
        --proto '=https' --tlsv1.2 --output "$downloaded" "$source"; then
        warn "source $source_index could not be downloaded"
        continue
    fi
    if [[ ! -s $downloaded || $(stat -c '%s' "$downloaded") -gt 262144 ]]; then
        warn "source $source_index returned an invalid payload size"
        continue
    fi
    if ! normalize_source "$downloaded" "$normalized"; then
        warn "source $source_index failed tracker validation"
        continue
    fi
    cat "$normalized" >> "$merged"
    ((successful_sources += 1))
done <<< "$tracker_sources"

((successful_sources > 0)) || die 'no tracker source produced a valid list'
awk -v limit="$tracker_limit" '!seen[$0]++ { print; if (++count >= limit) exit }' \
    "$merged" > "$selected"
tracker_count=$(awk 'END {print NR + 0}' "$selected")
((tracker_count >= minimum_trackers)) \
    || die "only $tracker_count valid trackers remained; refusing the update"
tracker_value=$(paste -sd, "$selected")

{
    printf '# Generated by aria2-update-trackers; do not edit.\n'
    printf 'bt-tracker=%s\n' "$tracker_value"
} > "$candidate"
chmod 0600 -- "$candidate"
if [[ -f $tracker_config ]] && cmp -s -- "$candidate" "$tracker_config"; then
    rm -f -- "$candidate"
else
    mv -- "$candidate" "$tracker_config"
fi

if [[ ${ARIA2_SKIP_RPC:-0} == 1 || ! -r $runtime_config || ! -r $secret_file ]]; then
    printf 'Cached %s trackers for the next aria2 start.\n' "$tracker_count"
    exit 0
fi

rpc_port=$(sed -n 's/^[[:space:]]*rpc-listen-port[[:space:]]*=[[:space:]]*//p' \
    "$runtime_config" | tail -n 1)
rpc_port=${rpc_port:-6800}
[[ $rpc_port =~ ^[0-9]+$ && $rpc_port -ge 1024 && $rpc_port -le 65535 ]] \
    || die "invalid RPC port in $runtime_config"
rpc_secret=$(<"$secret_file")
[[ $rpc_secret =~ ^[[:xdigit:]]{64}$ ]] \
    || die "$secret_file must contain exactly 64 hexadecimal characters"

# The jq program is intentionally single-quoted; $token and $trackers are jq variables.
# shellcheck disable=SC2016
payload=$("$jq_bin" -cn --arg token "token:$rpc_secret" \
    --arg trackers "$tracker_value" \
    '{jsonrpc:"2.0",id:"trackers",method:"aria2.changeGlobalOption",params:[$token,{"bt-tracker":$trackers}]}')
rpc_response="$work_root/rpc-response.json"
"$curl_bin" --fail --silent --show-error --connect-timeout 3 --max-time 10 \
    --header 'Content-Type: application/json' --data-binary "$payload" \
    --output "$rpc_response" "http://127.0.0.1:$rpc_port/jsonrpc" \
    || die 'tracker cache was updated, but the live aria2 RPC update failed'
"$jq_bin" -e '.id == "trackers" and .result == "OK"' "$rpc_response" \
    >/dev/null || die 'tracker cache was updated, but aria2 rejected the live tracker list'

printf 'Updated %s trackers and applied them to the live aria2 daemon.\n' \
    "$tracker_count"
